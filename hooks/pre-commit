#!/usr/bin/env bash
# Blocks `git commit` and `git commit --amend` under the wrong account.
#
# useConfigOnly catches a MISSING identity. It cannot catch a WRONG one —
# a repo-local user.email, or GIT_AUTHOR_EMAIL in the environment, both slip
# past it. This compares the identity git would actually use against the
# account the repo resolves to.
#
# Coverage note: this hook does NOT run for cherry-pick, revert, or rebase —
# git simply does not call it there. pre-push is the backstop for those.
#
# Bypass deliberately:  git commit --no-verify

set -uo pipefail
# shellcheck source=../lib/account-detect.sh
. "${GHMA_LIB:-$HOME/.local/libexec/gh-multi-account}/account-detect.sh"

ghma_verify_pending_identity || exit 1
ghma_chain_repo_hook pre-commit "$@"
exit 0
