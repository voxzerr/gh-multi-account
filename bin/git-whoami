#!/usr/bin/env bash
# git whoami — show which GitHub account this repo will act as.
#
#   git whoami            report identity for the current repo
#   git whoami --check    additionally test live SSH per account
#
# Reports what git ACTUALLY decided (by asking which config file supplied
# user.email) rather than only re-deriving the rules, so any drift between
# this tool and git shows up instead of hiding.

set -uo pipefail
# shellcheck source=../lib/account-detect.sh
. "${GHMA_LIB:-$HOME/.local/libexec/gh-multi-account}/account-detect.sh"
ghma_colors 1

CHECK=0
[ "${1:-}" = "--check" ] && CHECK=1

repo="$(git rev-parse --show-toplevel 2>/dev/null)"
if [ -z "$repo" ]; then
    printf '%sNot inside a git repository.%s\n' "$YEL" "$R"
    echo "Current directory: $(pwd)"
    exit 1
fi

detected="$(ghma_detect_account 2>/dev/null || true)"
from_git="$(ghma_account_from_git 2>/dev/null || true)"
name="$(git config --get user.name 2>/dev/null || true)"
email="$(git config --get user.email 2>/dev/null || true)"
origin_file="$(git config --show-origin --get user.email 2>/dev/null | awk '{print $1}' | sed 's/^file://')"
url="$(git config --get remote.origin.url 2>/dev/null || true)"

printf '%sRepo%s        %s\n' "$B" "$R" "$repo"

if [ -n "$detected" ]; then
    why="from remote URL"
    [ -n "$url" ] && ghma_account_for_url "$url" >/dev/null 2>&1 || why="from directory"
    printf '%sAccount%s     %s%s%s  %s(%s)%s\n' "$B" "$R" "$GRN" "$detected" "$R" "$DIM" "$why" "$R"
else
    printf '%sAccount%s     %sUNRESOLVED%s\n' "$B" "$R" "$RED" "$R"
fi

if [ -n "$email" ]; then
    printf '%sCommits as%s  %s <%s>\n' "$B" "$R" "$name" "$email"
    [ -n "$origin_file" ] && printf '            %sfrom %s%s\n' "$DIM" "${origin_file/#$HOME/~}" "$R"
else
    printf '%sCommits as%s  %sNOTHING — commits are blocked here%s\n' "$B" "$R" "$RED" "$R"
fi

# If our detection and git's actual answer disagree, that is a bug worth
# surfacing loudly rather than quietly picking one.
if [ -n "$detected" ] && [ -n "$from_git" ] && [ "$detected" != "$from_git" ]; then
    printf '\n%s%sWARNING: tooling and git disagree.%s\n' "$B" "$RED" "$R"
    printf '  this tool resolves: %s\n  git actually used:  %s\n' "$detected" "$from_git"
    printf '  Treat git as correct. Please report this.\n'
fi

if conflict="$(ghma_conflicting_remotes 2>/dev/null)"; then
    printf '\n%sRemotes point at more than one account: %s%s\n' "$YEL" "$conflict" "$R"
    echo "  Which one applies is decided by config ordering, which is arbitrary."
    echo "  Commits are blocked here until you set an explicit identity:"
    echo "    git config user.email <the address you mean>"
fi

if [ -n "$url" ]; then
    printf '%sRemote%s      %s\n' "$B" "$R" "$url"
    case "$url" in
        *github.com:*|*//github.com/*)
            printf '            %s^ names no account. Fix with:%s\n' "$YEL" "$R"
            printf '              git remote set-url origin git@github.com-<account>:owner/repo.git\n' ;;
    esac
else
    printf '%sRemote%s      %s(none yet)%s\n' "$B" "$R" "$DIM" "$R"
fi

if [ -n "$detected" ]; then
    cfg="$(ghma_config_dir "$detected")"
    ghlogin="$(GH_CONFIG_DIR="$cfg" "$GH_REAL" api user --jq .login 2>/dev/null || true)"
    if [ -n "$ghlogin" ]; then
        printf '%sgh CLI%s      logged in as %s%s%s\n' "$B" "$R" "$GRN" "$ghlogin" "$R"
    else
        printf '%sgh CLI%s      %snot logged in%s — run: ghma-setup %s\n' "$B" "$R" "$YEL" "$R" "$detected"
    fi
fi

if [ -z "$email" ]; then
    echo
    printf '%sCommits are blocked here.%s That is the safety net, not a bug:\n' "$YEL" "$R"
    echo "git will not invent an identity from your hostname. Fix by either:"
    echo "  - moving the repo under $PROJECTS_ROOT/<account>, or"
    echo "  - pointing its remote at an account alias (see above), or"
    echo "  - setting an identity for just this repo:"
    echo "      git config user.email you@example.com"
fi

if [ "$CHECK" = "1" ]; then
    printf '\n%sLive SSH check%s\n' "$B" "$R"
    for a in "${ACCOUNTS[@]}"; do
        out="$(ssh -o BatchMode=yes -o ConnectTimeout=8 -T "git@github.com-$a" 2>&1 || true)"
        who="$(echo "$out" | sed -n 's/^Hi \([^!]*\)!.*/\1/p')"
        if [ -n "$who" ]; then
            marker="  "; [ "$a" = "$detected" ] && marker="${GRN}->${R}"
            printf '  %s %-12s authenticates as %s%s%s\n' "$marker" "$a" "$GRN" "$who" "$R"
        else
            printf '     %-12s %sfailed%s %s(%s)%s\n' "$a" "$RED" "$R" "$DIM" "$(echo "$out" | head -1)" "$R"
        fi
    done
    printf '\n%sFor a full check of everything, run:%s ghma-doctor\n' "$DIM" "$R"
fi
